% ------------------------------------------------------------------ item check boxes ("do it" / "don't")
% r2states.tex (apply_edits.py) holds one \rritemstate{n}{ticked 1/0}{read-only 1/0}{reason} per item that has
% something to apply. Each such item is one AcroForm field "item-n" (a check box) with a widget at every tag of the
% item (drawn at shipout at the place the tag reserved, from the .aux positions of the previous run), in the header
% of its margin box and in its row of the decision sheet (\rritembox{n}); the widgets share the field's value, so
% ticking one ticks all. Read-only items (facts to give) look disabled. read_choices.py reads the saved PDF.
\newif\ifrr@boxes
\newlength{\rr@cbsize}\setlength{\rr@cbsize}{6.5bp}
\newcommand{\rritemstate}[4]{\rr@boxestrue
  \expandafter\gdef\csname rr@st@#1\endcsname{#2}\expandafter\gdef\csname rr@ro@#1\endcsname{#3}%
  \expandafter\gdef\csname rr@why@#1\endcsname{#4}\rr@newfield{#1}}
% the field of item #1, reserved when the states are read (so every field is known before the first page): listed
% in our /AcroForm, or in the one of pdfbase (animate, media9) when that package manages the form
\newcommand{\rr@newfield}[1]{\ifrr@nativeform\ifcsname rr@fld@#1\endcsname\else
  \pdfobj reserveobjnum \expandafter\xdef\csname rr@fld@#1\endcsname{\the\pdflastobj}%
  \expandafter\gdef\csname rr@kids@#1\endcsname{}%
  \edef\rr@tmpf{\noexpand\rr@writefield{#1}}\expandafter\g@addto@macro\expandafter\rr@itemfields\expandafter{\rr@tmpf}%
  \ifcsname pbs_appendtofields:n\endcsname
    \edef\rr@tmpf{\csname rr@fld@#1\endcsname\space 0 R}%
    \expandafter\expandafter\csname pbs_appendtofields:n\endcsname\expandafter{\rr@tmpf}%
  \else\xdef\rr@cbfields{\rr@cbfields\space\csname rr@fld@#1\endcsname\space 0 R}\fi
  \fi\fi}
\newcommand{\rr@boxat}[4]{% item, page, x, y (sp) of a tag: the widgets to draw on that page
  \ifcsname rr@bx@#2\endcsname
    \expandafter\xdef\csname rr@bx@#2\endcsname{\unexpanded\expandafter\expandafter\expandafter
      {\csname rr@bx@#2\endcsname}\noexpand\rr@dobox{#1}{#3}{#4}}%
  \else\expandafter\xdef\csname rr@bx@#2\endcsname{\noexpand\rr@dobox{#1}{#3}{#4}}\fi}
\newcommand{\rr@drawboxes}{\ifcsname rr@bx@\the\rr@abspage\endcsname
  \def\rr@dobox##1##2##3{\put(\dimexpr##2sp+0.5pt\relax,\dimexpr##3sp-\paperheight-0.3pt\relax){\rritembox{##1}}}%
  \csname rr@bx@\the\rr@abspage\endcsname\fi}
\def\rr@itemfields{}
\newcommand{\rr@ibsetup}{% appearances: ticked, unticked, disabled (6.5bp)
  \ifdefined\rr@ibyes\else
    \setbox\z@\hbox to 6.5bp{\vrule width\z@ height 6.5bp depth\z@\rr@literal{q 1 g 0.28 0.32 0.40 RG 0.55 w
      0.3 0.3 5.9 5.9 re B 0.75 0 0 RG 1.1 w 1 J 1 j 1.3 3.4 m 2.7 1.6 l 5.3 5.2 l S Q}\hfil}%
    \immediate\pdfxform\z@ \xdef\rr@ibyes{\the\pdflastxform}%
    \setbox\z@\hbox to 6.5bp{\vrule width\z@ height 6.5bp depth\z@\rr@literal{q 1 g 0.28 0.32 0.40 RG 0.55 w
      0.3 0.3 5.9 5.9 re B Q}\hfil}%
    \immediate\pdfxform\z@ \xdef\rr@iboff{\the\pdflastxform}%
    \setbox\z@\hbox to 6.5bp{\vrule width\z@ height 6.5bp depth\z@\rr@ibroglyph\hfil}%
    \immediate\pdfxform\z@ \xdef\rr@ibro{\the\pdflastxform}%
  \fi}
% the widget of item #1 here (zero depth, \rr@cbsize square); without pdfTeX a plain drawn box
\newcommand{\rritembox}[1]{\ifcsname rr@st@#1\endcsname
  \ifrr@nativeform
    \rr@ibsetup
    \rr@newfield{#1}%
    \pdfannot reserveobjnum \edef\rr@wobj{\the\pdflastannot}%
    \expandafter\xdef\csname rr@kids@#1\endcsname{\csname rr@kids@#1\endcsname\space\rr@wobj\space 0 R}%
    \pdfannot useobjnum \rr@wobj width \rr@cbsize height \rr@cbsize depth \z@ {/Subtype/Widget/F 4
      /Parent \csname rr@fld@#1\endcsname\space 0 R/H/P
      /AS/\if1\csname rr@st@#1\endcsname Yes\else Off\fi
      /MK<</BC[0.28 0.32 0.40]/BG[1 1 1]/CA(4)>>/DA(/ZaDb 0 Tf 0.75 0 0 rg)
      /AP<</N<</Yes \rr@ibyes\space 0 R/Off \if1\csname rr@ro@#1\endcsname\rr@ibro\else\rr@iboff\fi\space 0 R>>>>}%
    \hbox to \rr@cbsize{\vrule width\z@ height\rr@cbsize\hfil}%
  \else\if1\csname rr@ro@#1\endcsname\rrboxsym{2}\else\rrboxsym{\csname rr@st@#1\endcsname}\fi\fi\fi}
\newcommand{\rr@writefield}[1]{% the field: written once the last page is out
  \immediate\pdfobj useobjnum \csname rr@fld@#1\endcsname{<</FT/Btn/T(item-#1)
    /TU(report item #1: ticked = apply this change)
    /V/\if1\csname rr@st@#1\endcsname Yes\else Off\fi/Ff \if1\csname rr@ro@#1\endcsname 1\else 0\fi
    /Kids[\csname rr@kids@#1\endcsname]/DA(/ZaDb 0 Tf 0.75 0 0 rg)>>}}
% the disabled box of an item that waits for the authors' facts: a dashed orange square with three dots (never
% ticked; read_choices.py reports it as read-only)
\def\rr@ibroglyph{\rr@literal{q 0.99 0.95 0.90 rg 0.88 0.43 0 RG 0.6 w [1.2 0.8] 0 d 0.3 0.3 5.9 5.9 re B
  0.88 0.43 0 rg 1.45 3.0 0.75 0.75 re f 2.88 3.0 0.75 0.75 re f 4.3 3.0 0.75 0.75 re f Q}}
% a printed box symbol (legends; engines without form fields): 1 ticked, 0 not, 2 disabled (waits for your facts)
\newcommand{\rrboxsym}[1]{\leavevmode\hbox to 6.5bp{\vrule width\z@ height 6.5bp depth\z@
  \if2#1\rr@ibroglyph\else\if1#1\rr@literal{q 1 g 0.28 0.32 0.40 RG 0.55 w 0.3 0.3 5.9 5.9 re B 0.75 0 0 RG 1.1 w 1 J 1 j 1.3 3.4 m 2.7 1.6 l
    5.3 5.2 l S Q}\else\rr@literal{q 1 g 0.28 0.32 0.40 RG 0.55 w 0.3 0.3 5.9 5.9 re B Q}\fi\fi\hfil}}
% Clickable check boxes (decision sheet). pdfTeX: native widgets with explicit /Yes and /Off appearances, listed
% in the catalog's /AcroForm at the end (Preview and Acrobat can tick them and save the PDF). Other engines: hyperref
% \CheckBox fields. Put them between \rrbeginform and \rrendform.
\newif\ifrr@nativeform
\ifdefined\pdfannot\ifdefined\pdfxform\ifdefined\pdfcatalog\rr@nativeformtrue\fi\fi\fi
\def\rr@cbfields{}
\newcommand{\rr@addfield}[1]{% a field object: in pdfbase's /AcroForm when that package writes one, else in ours
  \ifcsname pbs_appendtofields:n\endcsname
    \edef\rr@tmpf{#1\space 0 R}%
    \expandafter\expandafter\csname pbs_appendtofields:n\endcsname\expandafter{\rr@tmpf}%
  \else\xdef\rr@cbfields{\rr@cbfields\space#1\space 0 R}\fi}
\newcommand{\rr@cbsetup}{% appearance streams and the ZapfDingbats font, once
  \ifdefined\rr@cbyes\else
    \setbox\z@\hbox to 9bp{\vrule width\z@ height 9bp depth\z@\rr@literal{q 1 g 0.37 0.41 0.47 RG 0.6 w
      0.3 0.3 8.4 8.4 re B Q}\hfil}%
    \immediate\pdfxform\z@ \xdef\rr@cboff{\the\pdflastxform}%
    \setbox\z@\hbox to 9bp{\vrule width\z@ height 9bp depth\z@\rr@literal{q 1 g 0.37 0.41 0.47 RG 0.6 w
      0.3 0.3 8.4 8.4 re B 0 0 0 RG 1.3 w 1 J 1 j 2 4.7 m 3.8 2.4 l 7.2 7.1 l S Q}\hfil}%
    \immediate\pdfxform\z@ \xdef\rr@cbyes{\the\pdflastxform}%
    \immediate\pdfobj{<</Type/Font/Subtype/Type1/BaseFont/ZapfDingbats>>}\xdef\rr@zadb{\the\pdflastobj}%
  \fi}
\newcommand{\rrcheckbox}[1]{%
  \ifrr@nativeform
    \rr@cbsetup
    \pdfannot reserveobjnum \edef\rr@cbobj{\the\pdflastannot}%
    \rr@addfield{\rr@cbobj}%
    \raisebox{-1.5pt}{\pdfannot useobjnum \rr@cbobj width 9bp height 9bp depth \z@ {/Subtype/Widget/FT/Btn/F 4
      /T(#1)/V/Off/AS/Off/H/P/MK<</BC[0.37 0.41 0.47]/BG[1 1 1]/CA(4)>>/DA(/ZaDb 0 Tf 0 g)
      /AP<</N<</Yes \rr@cbyes\space 0 R/Off \rr@cboff\space 0 R>>>>}\hbox to 9bp{\vrule width\z@ height 9bp\hfil}}%
  \else\ifdefined\CheckBox
    \raisebox{-1.5pt}{\CheckBox[name={#1},width=9pt,height=9pt,bordercolor={0.37 0.41 0.47},
      backgroundcolor={1 1 1}]{}}%
  \else\fbox{\phantom{x}}\fi\fi}
\newcommand{\rrbeginform}{\ifrr@nativeform\else\ifdefined\CheckBox\begin{Form}\fi\fi}
\newcommand{\rrendform}{\ifrr@nativeform\else\ifdefined\CheckBox\end{Form}\fi\fi}
% Answer fields: \rranswer{n}{width}{height} is a multi-line text field "answer-n" (empty, Helvetica 9pt, a visible
% border on a light background) where the author types the answer to the question of item n (decision sheet, under
% the question). pdfTeX: a native widget with its own appearance, listed in our /AcroForm or in pdfbase's (animate),
% with /Helv in the form's /DR. Other engines: a hyperref \TextField (between \rrbeginform and \rrendform).
% read_choices.py reads the typed text from the saved PDF.
\newlength{\rranswerheight}\setlength{\rranswerheight}{34bp}
\newlength{\rr@answ}\newlength{\rr@ansh}
\newcommand{\rr@txsetup}{% the Helvetica font of the form, once (also put in pdfbase's /DR when it writes the form)
  \ifdefined\rr@helv\else
    \rr@cbsetup
    \immediate\pdfobj{<</Type/Font/Subtype/Type1/BaseFont/Helvetica/Encoding/WinAnsiEncoding>>}%
    \xdef\rr@helv{\the\pdflastobj}%
    \ifcsname g_pbs_form_fonts_tl\endcsname
      \expandafter\xdef\csname g_pbs_form_fonts_tl\endcsname{\unexpanded\expandafter\expandafter\expandafter
        {\csname g_pbs_form_fonts_tl\endcsname}/Helv \rr@helv\space 0 R/ZaDb \rr@zadb\space 0 R}%
    \fi
  \fi}
\newcommand{\rranswer}[3]{\leavevmode\setlength{\rr@answ}{#2}\setlength{\rr@ansh}{#3}%
  \ifrr@nativeform
    \rr@txsetup
    \setbox\z@\hbox to \rr@answ{\vrule width\z@ height\rr@ansh depth\z@\rr@literal{q 0.96 0.975 1 rg 0.37 0.41 0.47 RG
      0.6 w 0.3 0.3 \strip@pt\dimexpr(\rr@answ-0.6bp)*7200/7227\relax\space
      \strip@pt\dimexpr(\rr@ansh-0.6bp)*7200/7227\relax\space re B Q}\hfil}%
    \immediate\pdfxform\z@ \edef\rr@txap{\the\pdflastxform}%
    \pdfannot reserveobjnum \edef\rr@txobj{\the\pdflastannot}%
    \rr@addfield{\rr@txobj}%
    \hbox to \rr@answ{\pdfannot useobjnum \rr@txobj width \rr@answ height \rr@ansh depth \z@ {/Subtype/Widget
      /FT/Tx/F 4/T(answer-#1)/TU(your answer to the question of report item #1)/Ff 4096/V()/DA(/Helv 9 Tf 0 g)/Q 0
      /MK<</BC[0.37 0.41 0.47]/BG[0.96 0.975 1]>>/AP<</N \rr@txap\space 0 R>>}\vrule width\z@ height\rr@ansh
      depth\z@\hfil}%
  \else\ifdefined\TextField
    \TextField[name={answer-#1},multiline=true,width=\rr@answ,height=\rr@ansh,bordercolor={0.37 0.41 0.47},
      backgroundcolor={0.96 0.975 1},charsize=9pt,value={}]{}%
  \else\fbox{\rule{0pt}{\dimexpr\rr@ansh-2\fboxsep\relax}\hspace{\dimexpr\rr@answ-2\fboxsep-2\fboxrule\relax}}\fi\fi}
\AddToHook{enddocument/afterlastpage}{\ifrr@nativeform\rr@itemfields\ifx\rr@cbfields\@empty\else
