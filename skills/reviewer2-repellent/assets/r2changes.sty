% r2changes.sty -- change marks and margin notes for the annotated copy of a paper (reviewer2-repellent, step 6).
% Written by scripts/apply_edits.py (marks, notes), scripts/mark_bbl.py (bibliography) and scripts/front_pages.py
% (cover and decision sheet); scripts/check_notes.py checks the placement from the .aux. Engines: pdfLaTeX (tested),
% XeLaTeX and LuaLaTeX. Needs LaTeX 2020-10 or later (hooks).
%
% Marks (every one carries #n, the number of its item in report.md):
%   \rrfix{n}{old}{new}             certain fix, applied: new text red, old text struck out
%   \rrcheck{n}{old}{new}{question} applied, to confirm: new text orange (the question goes in the item's note)
%   \rrstyle{n}{old}{new}           optional wording: new text purple
%   \rrmissing{n}{what}             facts only the authors have: an orange [#n: what] placeholder
%   \rrcheckmark{n}                 an orange #n alone, for a change to confirm that shows no text
%   \rrfixplain{n}{new}, \rrcheckplain{n}{new}{question}, \rrstyleplain{n}{new}
%                                   the same without struck text, for math, tables, captions and headings
%   \rrtag{colour}{n}               the #n tag alone (for hand-written marks)
% Notes:
%   \rrnote[file:line]{n}{text}     a light-blue box in the right margin explaining item n; the optional location
%                                   (in the corrected sources) is printed in small grey type at its bottom right.
%                                   Not inside floats, captions, footnotes or math: put it in the nearest paragraph
%                                   (or between paragraphs). It takes no space in the text.
%   \rrnotepair[file:line]{n}{text}{short}  the same with a short text, printed instead of text when the note is
%                                   listed in \jobname.rrs (\rrshortnote{k} per line, k = the note's number in the
%                                   .aux records; build_changes.py writes it for the notes of crowded pages)
% Links (with hyperref): the #n of a mark links to the box of item n on the same page; the #n of a box links back
% to the first mark of item n on that page (or to the note's place). \rranchor{n} sets \label{rr-n} and the target
% rr-n at the first mark or note of item n: \rrpageref{n} prints its page (-- if unknown), \rrlink{n}{text} links
% to it. The tag commands are disabled in PDF strings (bookmarks).
%
% Layout. The page is widened on the right by \rrmarginwidth (7cm) so the boxes fit and the paper's line and page
% breaks do not change; boxes are at most \rrnotemax (6.6cm) wide. Boxes are not \marginpar's: \rrnote records the
% page and the height of its line in the .aux (\rr@at{k}{n}{page}{y}), and at shipout every box is drawn on the page
% of its note, its top at the note's line. Boxes that would collide move down as little as possible, joined to
% their line by a thin light-blue leader; when a column overflows, the page's boxes are set in a smaller size first,
% and only then move up from the bottom. A box never leaves its page. Each drawn box writes
% \rr@placed{k}{note page}{box page}{shift} to the .aux, and a note with a short text \rr@hasshort{k}. Positions
% come from the previous run: rerun LaTeX until the .aux stops changing (3-4 runs).
%
% Front pages: with \usepackage[front]{r2changes} (loads tikz and hyperref): \rrbeginfront, then one
% \begin{rrfullpage}[id]...\end{rrfullpage} per page (full width, no legend, roman page numbers; the layout is in
% references/pdf-layout.md), then \rrbeginpaper
% (the paper starts on a new page numbered 1, with the colour legend at the bottom of its margin). Without front
% pages the legend is on the first page. \rrcheckbox{name} is a clickable PDF check box and \rranswer{n}{w}{h} a
% text field "answer-n" for the author's answer (both between \rrbeginform and \rrendform).
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{r2changes}[2026/11/11 reviewer2-repellent change marks]
\newif\ifrr@frontopt
\DeclareOption{front}{\rr@frontopttrue}
\ProcessOptions\relax
\RequirePackage{xcolor}
\RequirePackage[normalem]{ulem}
\ifrr@frontopt
  \RequirePackage{tikz}\RequirePackage{graphicx}
  \IfFileExists{animate.sty}{\IfFileExists{zref-abspage.sty}{\IfFileExists{ocgbase.sty}{\IfFileExists{pdfbase.sty}{\RequirePackage{animate}}{}}{}}{}}{}% the strip of the summary plays where JavaScript runs
  \RequirePackage{hyperref}
\fi
\definecolor{rrred}{RGB}{200,0,0}
\definecolor{rrorange}{RGB}{225,110,0}
\definecolor{rrpurple}{RGB}{120,40,170}
\definecolor{rrstrike}{RGB}{110,110,110}
\definecolor{rrbluebg}{RGB}{225,240,252}
\definecolor{rrblueframe}{RGB}{110,160,210}
% ------------------------------------------------------------------ engine
\ifdefined\pdfsavepos
  \let\rr@savepos\pdfsavepos \let\rr@lastypos\pdflastypos \let\rr@lastxpos\pdflastxpos
\else\ifdefined\savepos
  \let\rr@savepos\savepos \let\rr@lastypos\lastypos \let\rr@lastxpos\lastxpos
\else
  \PackageError{r2changes}{No \string\pdfsavepos: use pdfLaTeX, XeLaTeX or LuaLaTeX}{}%
\fi\fi
\ifdefined\pdfliteral \def\rr@literal#1{\pdfliteral{#1}}%
\else\ifdefined\pdfextension \def\rr@literal#1{\pdfextension literal{#1}}%
\else \def\rr@literal#1{\special{pdf:literal #1}}\fi\fi
% page counter shared by the .aux records and the shipout layer (1 = first page shipped)
\newcount\rr@abspage
\AddToHook{shipout/before}{\global\advance\rr@abspage\@ne}
\newcommand{\rr@target}[1]{\ifdefined\hypertarget\hypertarget{#1}{}\fi}
\newcommand{\rr@golink}[2]{\ifdefined\hyperlink\hyperlink{#1}{#2}\else#2\fi}
\newcommand{\rrlink}[2]{\rr@golink{rr-#1}{#2}}
\newcommand{\rrpageref}[1]{\ifcsname r@rr-#1\endcsname\ifdefined\hyperlink\pageref*{rr-#1}\else\pageref{rr-#1}\fi\else--\fi}
% ------------------------------------------------------------------ first anchor of an item
\DeclareRobustCommand{\rranchor}[1]{%
  \ifcsname rr@seen@#1\endcsname\else
    \expandafter\gdef\csname rr@seen@#1\endcsname{}%
    \rr@target{rr-#1}\label{rr-#1}%
  \fi}
% ------------------------------------------------------------------ tags (every mark), linked to their box
\newcounter{rr@mark}
\DeclareRobustCommand{\rr@tagged}[2]{% #1 item, #2 printed tag
  \stepcounter{rr@mark}\edef\rr@m{\the\c@rr@mark}%
  \rr@target{rrmark-\rr@m}%
  \edef\rr@w{\write\@auxout{\string\rr@markat{\rr@m}{#1}{\noexpand\the\rr@abspage}}}\rr@w
  \ifcsname rr@st@#1\endcsname\ifrr@boxes % room for the item's check box, drawn at shipout at this place
    \rr@savepos\edef\rr@w{\write\@auxout{\string\rr@boxat{#1}{\noexpand\the\rr@abspage}{\noexpand\the\rr@lastxpos}%
      {\noexpand\the\rr@lastypos}}}\rr@w\kern\dimexpr\rr@cbsize+1pt\relax
  \fi\fi
  \ifcsname rr@mpg@\rr@m\endcsname
    \ifcsname rr@boxfor@#1@\csname rr@mpg@\rr@m\endcsname\endcsname
      \rr@golink{rrbox-\csname rr@boxfor@#1@\csname rr@mpg@\rr@m\endcsname\endcsname}{#2}%
    \else #2\fi
  \else #2\fi}
\newcommand{\rr@markat}[3]{% mark, item, page (read from the .aux)
  \expandafter\xdef\csname rr@mpg@#1\endcsname{#3}%
  \ifcsname rr@firstmark@#2@#3\endcsname\else\expandafter\xdef\csname rr@firstmark@#2@#3\endcsname{#1}\fi}
\newcommand{\rrtag}[2]{\textsuperscript{\rr@tagged{#2}{\textcolor{#1}{\sffamily\scriptsize\##2}}}}
\newcommand{\rrold}[1]{\ifx\relax#1\relax\else{\color{rrstrike}\sout{#1}}\fi}
\newcommand{\rrfix}[3]{\rranchor{#1}\rrold{#2}{\color{rrred}#3}\rrtag{rrred}{#1}}
\newcommand{\rrcheck}[4]{\rranchor{#1}\rrold{#2}{\color{rrorange}#3}\rrtag{rrorange}{#1}}
\newcommand{\rrstyle}[3]{\rranchor{#1}\rrold{#2}{\color{rrpurple}#3}\rrtag{rrpurple}{#1}}
\newcommand{\rrmissing}[2]{\rranchor{#1}{\color{rrorange}\sffamily[\rr@tagged{#1}{\##1}: #2]}}
\newcommand{\rrcheckmark}[1]{\rranchor{#1}\rrtag{rrorange}{#1}}
\newcommand{\rrfixplain}[2]{{\color{rrred}#2}\rrtag{rrred}{#1}}
\newcommand{\rrcheckplain}[3]{{\color{rrorange}#2}\rrtag{rrorange}{#1}}
\newcommand{\rrstyleplain}[2]{{\color{rrpurple}#2}\rrtag{rrpurple}{#1}}
% ------------------------------------------------------------------ geometry
\newlength{\rrmarginwidth}\setlength{\rrmarginwidth}{7cm}
\newlength{\rrnotemax}\setlength{\rrnotemax}{6.6cm}
\newlength{\rrtextright}
\newlength{\rrnotewidth}
\newlength{\rr@sep}\setlength{\rr@sep}{0.45cm}
\newcommand{\rr@pdfstrings}{% marks in bookmarks: the new text only
  \let\rr@tagged\@secondoftwo\let\rranchor\@gobble\let\rrtag\@gobbletwo\let\rrnote\rr@gobblenote\let\rrnotepair\rr@gobblepair
  \def\rrfix##1##2##3{##3}\def\rrstyle##1##2##3{##3}\def\rrcheck##1##2##3##4{##3}\def\rrcheckmark##1{}%
  \def\rrfixplain##1##2{##2}\def\rrstyleplain##1##2{##2}\def\rrcheckplain##1##2##3{##2}}
\newcommand{\rr@gobblenote}[3][]{}
\newcommand{\rr@gobblepair}[4][]{}
\AddToHook{begindocument/end}{%
  \ifdefined\hypersetup\hypersetup{hidelinks}\fi
  \ifdefined\pdfstringdefDisableCommands\pdfstringdefDisableCommands{\rr@pdfstrings}\fi
  \addtolength{\paperwidth}{\rrmarginwidth}%
  \ifdefined\pdfpagewidth\setlength{\pdfpagewidth}{\paperwidth}\fi
  \ifdefined\pagewidth\setlength{\pagewidth}{\paperwidth}\fi
  \ifdim\oddsidemargin>\evensidemargin
    \setlength{\rrtextright}{\dimexpr1in+\hoffset+\oddsidemargin+\textwidth\relax}%
  \else
    \setlength{\rrtextright}{\dimexpr1in+\hoffset+\evensidemargin+\textwidth\relax}%
  \fi
  \setlength{\rrnotewidth}{\dimexpr\paperwidth-\rrtextright-\rr@sep-0.55cm\relax}%
  \ifdim\rrnotewidth>\rrnotemax\setlength{\rrnotewidth}{\rrnotemax}\fi
  \InputIfFileExists{r2states.tex}{}{}%
  \rrbuildlegend
  \ifrrfront\else\rrarmlegend\fi
  \InputIfFileExists{\jobname.rrs}{}{}}
% ------------------------------------------------------------------ notes
\newcounter{rr@note}
\newcommand{\rrnote}[3][]{\rr@mknote{#1}{#2}{#3}{}}
\newcommand{\rrnotepair}[4][]{\rr@mknote{#1}{#2}{#3}{#4}}
\newcommand{\rrshortnote}[1]{\expandafter\gdef\csname rr@useshort@#1\endcsname{}}
\newcommand{\rr@mknote}[4]{\rranchor{#2}%
  \stepcounter{rr@note}\edef\rr@k{\the\c@rr@note}%
  \expandafter\gdef\csname rr@item@\rr@k\endcsname{#2}%
  \expandafter\gdef\csname rr@body@\rr@k\endcsname{#3}%
  \expandafter\gdef\csname rr@short@\rr@k\endcsname{#4}%
  \ifx\relax#4\relax\else\edef\rr@w{\write\@auxout{\string\rr@hasshort{\rr@k}}}\rr@w\fi
  \expandafter\gdef\csname rr@loc@\rr@k\endcsname{#1}%
  \ifvmode\else\leavevmode\fi % between paragraphs the note stays in the vertical list: no empty paragraph
  \rr@target{rrnote-\rr@k}\rr@savepos
  \edef\rr@w{\write\@auxout{\string\rr@at{\rr@k}{#2}{\noexpand\the\rr@abspage}{\noexpand\the\rr@lastypos}}}\rr@w
  \ifvmode\nobreak\fi}
\newcommand{\rr@at}[4]{% note, item, page, y (sp from the page bottom) -- read from the .aux
  \ifcsname rr@pg@#1\endcsname\else
    \expandafter\xdef\csname rr@pg@#1\endcsname{#3}%
    \expandafter\xdef\csname rr@y@#1\endcsname{#4}%
    \ifcsname rr@list@#3\endcsname
      \expandafter\xdef\csname rr@list@#3\endcsname{\unexpanded\expandafter\expandafter\expandafter
        {\csname rr@list@#3\endcsname}\noexpand\rr@do{#1}}%
    \else\expandafter\xdef\csname rr@list@#3\endcsname{\noexpand\rr@do{#1}}\fi
    \ifcsname rr@boxfor@#2@#3\endcsname\else\expandafter\xdef\csname rr@boxfor@#2@#3\endcsname{#1}\fi
  \fi}
\newcommand{\rr@placed}[4]{}
\newcommand{\rr@hasshort}[1]{}
\newcommand{\rr@notesize}{\scriptsize}
\newbox\rr@b
\newcommand{\rr@setnote}[1]{% typeset note #1 into \rr@b
  \setbox\rr@b\hbox{\setlength{\fboxsep}{3pt}\fcolorbox{rrblueframe}{rrbluebg}{%
    \parbox{\dimexpr\rrnotewidth-2\fboxsep-2\fboxrule\relax}{\raggedright\sffamily\rr@notesize
    \edef\rr@n{\csname rr@item@#1\endcsname}\edef\rr@p{\csname rr@pg@#1\endcsname}%
    \ifcsname rr@st@\rr@n\endcsname\ifrr@boxes\leavevmode\kern\dimexpr\rr@cbsize+2pt\relax\fi\fi
    \ifcsname rr@firstmark@\rr@n @\rr@p\endcsname
      \rr@golink{rrmark-\csname rr@firstmark@\rr@n @\rr@p\endcsname}{\textbf{\#\rr@n}}%
    \else\rr@golink{rrnote-#1}{\textbf{\#\rr@n}}\fi
    \ \ifcsname rr@useshort@#1\endcsname
      \expandafter\ifx\csname rr@short@#1\endcsname\@empty\csname rr@body@#1\endcsname
      \else\csname rr@short@#1\endcsname\fi
    \else\csname rr@body@#1\endcsname\fi
    \let\rr@whyhere\@empty
    \ifcsname rr@why@\rr@n\endcsname\ifrr@boxes\edef\rr@whyhere{\csname rr@why@\rr@n\endcsname}\fi\fi
    \ifx\rr@whyhere\@empty\expandafter\ifx\csname rr@loc@#1\endcsname\@empty\else\def\rr@whyhere{ }\fi\fi
    \ifx\rr@whyhere\@empty\else
      \par\vspace{1pt}{\fontsize{5.6}{6.6}\selectfont\color{rrstrike}{\itshape\rr@whyhere}\hfill
      \ttfamily\csname rr@loc@#1\endcsname}\fi}}}}
\newdimen\rr@cur \newdimen\rr@lim \newdimen\rr@top \newdimen\rr@h \newdimen\rr@gap \newdimen\rr@toplim
\newdimen\rr@botlim
\setlength{\rr@gap}{2.5pt}
\newif\ifrr@over
% One layout pass at the current size, top to bottom: each box at its line or just below the previous box; tops
% (from the page bottom) in \rr@t@k. If the last box runs past the bottom, \ifrr@over is set and a bottom-up pass
% moves boxes up just enough (\rr@drawnotes first retries with smaller sizes).
\newcommand{\rr@layout}{%
  \rr@overfalse
  \rr@cur=\rr@toplim
  \def\rr@do##1{%
    \rr@setnote{##1}\rr@h=\dimexpr\ht\rr@b+\dp\rr@b\relax
    \expandafter\xdef\csname rr@h@##1\endcsname{\the\rr@h}%
    \rr@top=\dimexpr\csname rr@y@##1\endcsname sp+7.5pt\relax
    \ifdim\rr@top>\rr@cur \rr@top=\rr@cur\fi
    \expandafter\xdef\csname rr@t@##1\endcsname{\the\rr@top}%
    \rr@cur=\dimexpr\rr@top-\rr@h-\rr@gap\relax}%
  \csname rr@list@\the\rr@abspage\endcsname
  \ifdim\dimexpr\rr@cur+\rr@gap\relax<\rr@botlim
    \rr@overtrue
    \let\rr@rev\@empty
    \def\rr@do##1{\edef\rr@rev{\noexpand\rr@do{##1}\unexpanded\expandafter{\rr@rev}}}%
    \csname rr@list@\the\rr@abspage\endcsname
    \rr@lim=\rr@botlim
    \def\rr@do##1{%
      \rr@top=\csname rr@t@##1\endcsname\relax
      \rr@h=\csname rr@h@##1\endcsname\relax
      \ifdim\dimexpr\rr@top-\rr@h\relax<\rr@lim \rr@top=\dimexpr\rr@lim+\rr@h\relax\fi
      \expandafter\xdef\csname rr@t@##1\endcsname{\the\rr@top}%
      \rr@lim=\dimexpr\rr@top+\rr@gap\relax}%
    \rr@rev
  \fi}
\newcommand{\rr@drawnotes}{%
  \ifcsname rr@list@\the\rr@abspage\endcsname
    \rr@toplim=\dimexpr\paperheight-1in-\voffset-\topmargin+4pt\relax
    \ifrr@legendhere
      \rr@botlim=\dimexpr1.2cm+\ht\rrlegendbox+\dp\rrlegendbox+6pt\relax
    \else\rr@botlim=0.9cm\fi
    \def\rr@notesize{\scriptsize}\rr@layout
    \ifrr@over\def\rr@notesize{\fontsize{6.3}{7.3}\selectfont}\rr@layout\fi
    \ifrr@over\def\rr@notesize{\fontsize{5.8}{6.7}\selectfont}\rr@layout\fi
    \def\rr@do##1{%
      \rr@setnote{##1}%
      \rr@top=\csname rr@t@##1\endcsname\relax
      \rr@h=\dimexpr\csname rr@y@##1\endcsname sp+7.5pt-\rr@top\relax % how far the box moved down
      \put(\dimexpr\rrtextright+\rr@sep\relax,\dimexpr\rr@top-\paperheight\relax){%
        \raisebox{-\height}[0pt][0pt]{\rr@target{rrbox-##1}\box\rr@b}}%
      \edef\rr@n{\csname rr@item@##1\endcsname}%
      \ifcsname rr@st@\rr@n\endcsname\ifrr@boxes
        \put(\dimexpr\rrtextright+\rr@sep+3pt+0.4pt\relax,\dimexpr\rr@top-\paperheight-3.4pt-\rr@cbsize\relax){%
          \rritembox{\rr@n}}\fi\fi
      \ifdim\rr@h>1.5pt
        \put(\dimexpr\rrtextright+2pt\relax,\dimexpr\csname rr@y@##1\endcsname sp+2.5pt-\paperheight\relax){%
          \rr@leader{\dimexpr\rr@sep-2pt\relax}{\dimexpr-\rr@h+1pt\relax}}%
      \fi
      \immediate\write\@auxout{\string\rr@placed{##1}{\csname rr@pg@##1\endcsname}{\the\rr@abspage}{\the\rr@h}}}%
    \csname rr@list@\the\rr@abspage\endcsname
  \fi}
% leader: from the text edge at the note's line down to the box top (0.4pt, the frame colour)
\newcommand{\rr@leader}[2]{\rr@literal{q 0.4 w 0.43 0.63 0.82 RG 0 0 m
  \strip@pt\dimexpr#1\relax\space\strip@pt\dimexpr#2\relax\space l S Q}}
\AddToHook{shipout/foreground}{\rr@drawnotes\rr@drawboxes\ifrr@legendhere\rrlegend\global\rr@legendherefalse\fi}
% ------------------------------------------------------------------ legend
\newif\ifrr@legendhere
\newif\ifrrfront
\newcommand{\rrarmlegend}{\global\rr@legendheretrue}
\newcommand{\rrlegendtext}{%
  \textbf{How to read this copy.} Every change carries \textbf{\#n}, its item in report.md.\par
  \textcolor{rrred}{\textbf{Red}}: error fixed (old text \textcolor{rrstrike}{\sout{struck out}}).\par
  \textcolor{rrorange}{\textbf{Orange}}: fix applied, to confirm; \textcolor{rrorange}{[\#n: \dots]} needs facts
  only the authors have.\par
  \textcolor{rrpurple}{\textbf{Purple}}: optional wording.\par
  \colorbox{rrbluebg}{\textbf{\#n}} Margin notes explain each item and ask the questions; click \#n to jump between
  a change and its note.\ifrr@boxes\par
  \rrboxsym{1}\,= will be applied, \rrboxsym{0}\,= will not: click to change, then save the PDF;
  \rrboxsym{2}\,= waits for your facts (cannot be ticked).\fi}
\newsavebox{\rrlegendbox}
\newcommand{\rrbuildlegend}{%
  \sbox{\rrlegendbox}{\setlength{\fboxsep}{4pt}\fcolorbox{rrblueframe}{white}{%
    \parbox[b]{\dimexpr\rrnotewidth-2\fboxsep-2\fboxrule\relax}{\raggedright\sffamily\scriptsize\rrlegendtext}}}}
\newcommand{\rrlegend}{%
  \put(\dimexpr\rrtextright+\rr@sep\relax,\dimexpr-\paperheight+1.2cm\relax){\usebox{\rrlegendbox}}}
% ------------------------------------------------------------------ front pages
\newcommand{\rrfrontpages}{\rrfronttrue}
\ifrr@frontopt\rrfronttrue\fi
\newcommand{\rrbeginfront}{\clearpage\pagenumbering{roman}}
\newcommand{\rrbeginpaper}{\clearpage\pagenumbering{arabic}\rrarmlegend
  \edef\rr@w{\write\@auxout{\string\rr@paperstart{\noexpand\the\rr@abspage}}}\rr@w}
\newcommand{\rr@paperstart}[1]{}% the absolute page (1 = first page shipped) where the paper starts (read by front_pages.py)
\newsavebox{\rr@fullbox}
\newlength{\rrfullwidth}
\newlength{\rrfullheight}
% rrfullpage[id]: one front page, full width. The content is set at its natural height (the fill, written to the log
% as "rrfront fill: id=<id> page=<p> natural=<pt> full=<pt>"), then, when it fits, stretched to the full height:
% only glue with fil stretch (\rrFgap) grows, so the slack goes between sections, not to the bottom.
\newcommand{\rrFgap}[2][1]{\par\vskip #2 plus #1fil\relax}% \rrFgap[share of the slack]{natural space}
\newenvironment{rrfullpage}[1][page]{\clearpage\thispagestyle{empty}%
  \def\rr@fullid{#1}%
  \setlength{\rrfullwidth}{\dimexpr\paperwidth-68bp\relax}%
  \setlength{\rrfullheight}{\dimexpr\paperheight-64bp\relax}%
  \setbox\rr@fullbox\vtop\bgroup\color@begingroup\hsize\rrfullwidth\linewidth\hsize\columnwidth\hsize
    \@totalleftmargin\z@\@parboxrestore\setlength{\parindent}{0pt}\@minipagetrue}{%
  \par\kern\z@\color@endgroup\egroup % (the kern: a page ending in a deep line, e.g. top-aligned minipages, keeps it)
  \@tempdimb=\dimexpr\ht\rr@fullbox+\dp\rr@fullbox\relax
  \typeout{rrfront fill: id=\rr@fullid\space page=\thepage\space natural=\the\@tempdimb\space full=\the\rrfullheight}%
  \ifdim\@tempdimb>\rrfullheight
    \PackageWarningNoLine{r2changes}{Front page too tall (page \thepage): its content overflows the page}%
  \else
    \begingroup\vbadness\@M\global\setbox\rr@fullbox\vtop to\rrfullheight{\unvbox\rr@fullbox}\endgroup
  \fi
  \@tempdima=\oddsidemargin
  \if@twoside\ifodd\value{page}\else\@tempdima=\evensidemargin\fi\fi
  \noindent\begin{picture}(0,0)\put(\dimexpr-1in-\hoffset-\@tempdima+34bp\relax,
    \dimexpr1in+\voffset+\topmargin+\headheight+\headsep-30bp\relax){\usebox{\rr@fullbox}}\end{picture}\clearpage}
% ------------------------------------------------------------------ the strip of the summary's apply box
\ifrr@frontopt
\newlength{\rrFcu}
% the strip of the apply box: the four cards of the README's "how it works" (1 Install, 2 Run, 3 Choose in this
% file, 4 Apply), drawn in its coordinates (226 x 248 units per card, y down); #1 = the lit card (0: all lit, the
% static strip shown by every viewer and in print)
\definecolor{rrcG}{HTML}{0B3A26}\definecolor{rrcK}{HTML}{16181D}\definecolor{rrcP}{HTML}{FDFBF4}
\definecolor{rrcB}{HTML}{2A7FC6}\definecolor{rrcBb}{HTML}{E6F1FB}\definecolor{rrcR}{HTML}{C80000}
\definecolor{rrcO}{HTML}{E07B00}\definecolor{rrcV}{HTML}{7B3FA0}\definecolor{rrcN}{HTML}{D9ECFA}
\definecolor{rrcY}{HTML}{F2C14E}\definecolor{rrcYd}{HTML}{E0A000}\definecolor{rrcE}{HTML}{1F8A5B}
\definecolor{rrcGr}{HTML}{E4E2DC}\definecolor{rrcGh}{HTML}{CFCCC4}\definecolor{rrcL}{HTML}{8FD0FF}
\definecolor{rrcT}{HTML}{E8E8E8}\definecolor{rrcM}{HTML}{7FDC9F}
\newcommand{\rrFcardhead}[2]{\fill[rrcP,draw=rrcG,line width=1.2pt,rounded corners=5pt] (0,0) rectangle (226,248);
  \fill[rrcG] (24,26) circle (13);\node[text=white,font=\sffamily\bfseries\fontsize{7.5}{7.5}\selectfont] at (24,26) {#1};
  \node[anchor=west,text=rrcK,font=\sffamily\bfseries\fontsize{8.6}{8.6}\selectfont] at (42,26) {#2};}
\newcommand{\rrFcards}[1]{\begin{tikzpicture}[x=\rrFcu,y=-\rrFcu,line cap=round,line join=round]
